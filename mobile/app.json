{
  "expo": {
    "name": "SyncNestMobile",
    "slug": "SyncNestMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.byteX.syncnest",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      ["expo-camera", { "cameraPermission": "Allow SyncNest to scan the hub QR code" }]
    ],
    "extra": {
      "eas": {
        "projectId": "10943f8f-fbd6-4e02-98b3-c9ece63b2bdb"
      }
    }
  }
}
